---
import clsx from "clsx";

const { class: className } = Astro.props;

const defaultStyle =
  "bg-surface-strong border border-surface-strong dark:bg-surface p-2 rounded-sm hover:scale-105 transition-transform duration-300 ease-in-out";
---

<article class={clsx(defaultStyle, className)}>
  <slot />
</article>
