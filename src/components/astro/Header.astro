---
import type { Locale } from "@/types";
import { appendBaseUrl, getTranslation } from "@/utils";
import Link from "./Link.astro";
import { ThemeToggler } from "../react/ThemeToggler";
import { MobileMenu } from "../react/MobileMenu";

const { currentLocale } = Astro;
const { t } = getTranslation(currentLocale as Locale);

const sections = Object.values(t("sections"));
const languageUrl = t("components.header.languageUrl");
const flagUrl = t("components.header.flagUrl");
const languageCaption = t("components.header.languageCaption");
const lang = currentLocale as Locale;
---

<header
  class="sticky z-50 transform-gpu backdrop-blur-sm top-0 border-b border-border-strong"
>
  <nav
    class="p-4 max-w-6xl mx-auto hidden md:flex justify-between items-center"
  >
    <a
      href={appendBaseUrl("/")}
      class="font-bold cursor-pointer text-xl hover:scale-105 transition-all duration-300 hover:text-accent"
    >
      {t("site.author_shortname")}</a
    >

    <ul class="flex items-center gap-4">
      {
        sections.map((el) => {
          return <Link variant="menu" {...el} />;
        })
      }
    </ul>

    <section class="flex items-center gap-4">
      <a class="flex items-center gap-2 py-1" href={appendBaseUrl(languageUrl)}>
        <img
          width={32}
          height={32}
          src={flagUrl}
          alt={t("components.header.flagCaption")}
        />
        {languageCaption}
      </a>
      <ThemeToggler lang={lang} client:only="react" />
    </section>
  </nav>

  <MobileMenu locale={lang} client:only="react" />
</header>
