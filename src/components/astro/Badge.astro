---
import type { BadgeType } from "@/types";
import { Icon } from "astro-icon/components";
import clsx from "clsx";

interface Props {
  name: string;
  icon?: string;
  color?: string;
  type?: BadgeType;
  class?: string;
}

const { name, icon, color, type = "normal", class: className } = Astro.props;

const typeStyles: Record<BadgeType, string> = {
  normal: "bg-gray-200 dark:bg-dark-500",
  graduated:
    "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300 border border-green-200 dark:border-green-800 uppercase",
  completed:
    "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 border border-blue-200 dark:border-blue-800 uppercase",
  ongoing:
    "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 border border-amber-200 dark:border-amber-800 uppercase",
};

const hasIcon = Boolean(icon);
const iconName = hasIcon ? `devicon:${icon}` : null;
---

<article
  class={clsx(
    "inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold translation-colors",
    typeStyles[type],
    className,
  )}
>
  {iconName && <Icon name={iconName} class="w-3.5 h-3.5 shirnk-0" />}
  <span>{name}</span>
</article>
