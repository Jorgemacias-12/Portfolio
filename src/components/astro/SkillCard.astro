---
import type { SkillCardProps as Props } from "@/types";
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import clsx from "clsx";

const { class: className, color, label, tagline, technologies } = Astro.props;
---

<Card class={clsx("flex flex-col justify-between gap-4", className)}>
  <h3 class={clsx(color, "font-bold mono")}>{label}</h3>

  <main class="flex flex-wrap gap-2">
    {technologies.map((el) => <Badge {...el} />)}
  </main>

  <footer class="text-sm">{tagline}</footer>
</Card>
