---
import type { Locale, Project as Props } from "@/types";
import Card from "./Card.astro";
import { Icon } from "astro-icon/components";
import { getTranslation } from "@/utils";
import { ExternalLink } from "@lucide/astro";
import { MoreHorizontal } from "lucide-react";
import { Carrousel } from "../react/Carrousel";

const { name, description, demo_link, links, media, repo_link } = Astro.props;
const { t } = getTranslation(Astro.currentLocale as Locale);
---

<Card class="flex flex-col gap-4 justify-between">
  <header class="flex flex-col gap-2">
    <Carrousel
      client:only="react"
      locale={Astro.currentLocale! as Locale}
      images={media}
    />

    <h3
      class="text-xl text-balance font-semibold text-accent-600 dark:text-accent-500"
    >
      {name}
    </h3>
  </header>
  <main>
    <p class="text-sm text-gray-500 dark:text-gray-100/60">{description}</p>
  </main>
  <footer class="flex gap-2">
    {
      demo_link && (
        <a
          target="_blank"
          href={demo_link}
          rel="norefferer no opener"
          class="flex items-center gap-2 px-3 py-2 text-xs rounded-md bg-accent-600 hover:bg-accent-700 dark:bg-accent-500 hover:dark:bg-accent-600 text-white transition"
        >
          <ExternalLink />
          {t("components.project.demo_label")}
        </a>
      )
    }

    {
      repo_link && (
        <a
          href={repo_link}
          target="_blank"
          rel="noreferrer noopener"
          class="text-xs flex items-center gap-2 border p-2 rounded-md transition "
        >
          <Icon class="text-black dark:text-white" name="github" />
          {t("components.project.repo_link_label")}
        </a>
      )
    }

    {
      links && links.length > 0 && (
        <details class="relative">
          <summary class="cursor-pointer list-none p-2 rounded-md hover:bg-gray-300 hover:dark:bg-dark-450">
            <MoreHorizontal />
          </summary>

          <section class="absolute bottom-full mb-2 left-0 bg-white dark:bg-dark-800 rounded-md shadow-lg p-2 flex flex-col gap-1 min-w-37.5">
            {links.map(({ label, href }) => (
              <a
                href={href}
                target="_blank"
                rel="noreferrer noopener"
                class="text-sm px-2 py-1 rounded hover:bg-gray-300 hover:dark:bg-dark-600"
              >
                {label}
              </a>
            ))}
          </section>
        </details>
      )
    }
  </footer>
</Card>
