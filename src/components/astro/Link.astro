---
import type {
  LinkVariant,
  LinkVariantConfig,
  LinkComponentProps as Props,
} from "@/types";
import { appendBaseUrl } from "@/utils";
import { Icon } from "astro-icon/components";
import clsx from "clsx";

const {
  label,
  url,
  variant = "link",
  rel = "noopener noreferrer",
  icon,
  target,
  class: classes,
} = Astro.props;

const config: Record<LinkVariant, LinkVariantConfig> = {
  menu: {
    href: appendBaseUrl(`#${url}`),
    rel: rel!,
    wrapper: "li",
    classes:
      "link list-none text-sm flex flex-1 w-full p-2 rounded-md text-sm text-text hover:bg-accent hover:text-white active:bg-accent active:text-white text-nowrap transition-all duration-200",
  },
  iconified: {
    wrapper: Fragment,
    href: url,
    classes: "inline-flex items-center gap-2 hover:text-accent hover:underline",
  },
  link: {
    href: url,
    rel: rel!,
    wrapper: Fragment,
    classes: "text-black dark:text-white hover:text-accent hover:underline",
  },
  cta: {
    wrapper: Fragment,
    href: url,
    classes:
      "inline-flex flex-row-reverse items-center  rounded-md p-2 bg-accent gap-2",
  },
};

const current = config[variant] ?? config.link;
const Wrapper = current.wrapper;

const isIconDefinition = typeof icon === "object" && icon !== null;
const isIconName = typeof icon === "string";

const iconProps = isIconDefinition
  ? { style: "color: currentColor;", ...icon }
  : isIconName
    ? { name: icon }
    : null;
---

<!-- add list-none when using alone menu type to avoid list style appears when using wrappers / containers that are not lists -->
<Wrapper class="list-none">
  <a
    href={current.href}
    target={target}
    rel={current.rel}
    aria-label={variant === "menu" ? label : undefined}
    data-url={variant === "menu" ? url : undefined}
    class={clsx(current.classes, classes)}
  >
    {iconProps && <Icon {...iconProps} />}
    <span>{label}</span>
  </a>
</Wrapper>
