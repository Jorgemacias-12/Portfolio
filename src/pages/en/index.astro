---
import Section from "@/components/astro/Section.astro";
import Layout from "@/layouts/Layout.astro";
import { PORTFOLIO_SECTIONS } from "@/sections";
import type { Locale } from "@/types";
import { getTranslation } from "@/utils";

const { t } = getTranslation(Astro.currentLocale as Locale);
---

<Layout>
  {
    PORTFOLIO_SECTIONS.map(async ({ key, loader, showTitle }) => {
      const Component = (await loader()).default;

      const label = t(`sections.${key}.label`);

      return (
        <Section id={key} showTitle={showTitle} title={label} variant="normal">
          <Component />
        </Section>
      );
    })
  }
</Layout>
