    "projects": [
      {
        "name": "NBTMap Explorer",
        "description": "Aplicación de escritorio desarrollada en C# para explorar, visualizar y exportar mapas de objetos de Minecraft (map_*.dat) desde archivos NBT, sin necesidad de ejecutar Minecraft o usar mods.",
        "status": "active",
        "context": {
          "problem": "Los mapas de objetos de Minecraft se almacenan en archivos NBT que no son fácilmente legibles ni visualizables fuera del juego, dificultando su análisis o reutilización.",
          "role": "Desarrollador principal encargado de la lógica de la aplicación, análisis de NBT, renderizado de mapas y arquitectura general. El prototipo de UI se diseñó en colaboración con un diseñador.",
          "approach": "Diseño e implementación de una aplicación de escritorio en WPF siguiendo el patrón MVVM para leer y procesar datos NBT, interpretar la información de los mapas y exportarlos como imágenes.",
          "challenges": [
            "Comprender y analizar correctamente la estructura de datos NBT",
            "Renderizar los mapas respetando la escala y los colores",
            "Detectar instalaciones de Minecraft y rutas de mundos en Windows"
          ],
          "learnings": [
            "Trabajo con formatos binarios y estructuras de datos",
            "Aplicación práctica del patrón MVVM en WPF",
            "Separación de responsabilidades entre UI y lógica de negocio"
          ]
        },
