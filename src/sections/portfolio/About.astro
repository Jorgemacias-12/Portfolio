---
import { RotateText } from "@/components/react/RotateText";
import { type Locale } from "@/types";
import { getTranslation } from "@/utils";

const { currentLocale } = Astro;
const { t } = getTranslation(currentLocale as Locale);
---

<section
  class="flex flex-col-reverse md:flex-row gap-4 items-center justify-between"
>
  <div id="hero-text" class="w-auto flex flex-col gap-4 space-y-4">
    <div class="flex flex-col gap-4">
      <p
        class="text-lg text-gray-500 dark:text-gray-400 opacity-0 entry-element"
      >
        {t("sections_data.about.greeting")}
      </p>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground text-balance opacity-0 entry-element"
      >
        {t("sections_data.about.short_name")}
      </h1>

      <p
        class="text-xl sm:text-2xl text-accent-600 dark:text-accent-500 font-medium opacity-0 entry-element"
      >
        {t("sections_data.about.position")}
      </p>

      <p
        id="typewritter-text"
        class="inline-flex flex-col gap-2 w-fit opacity-0 entry-element"
      >
        <span
          id="typewriter-text"
          class="text-accent-600 dark:text-accent-500 text-xl"
          style={{
            "--characters":
              typeof t("sections_data.about.stack") === "string"
                ? t("sections_data.about.stack").length
                : 0,
          } as React.CSSProperties}
        >
          {
            typeof t("sections_data.about.stack") === "string"
              ? t("sections_data.about.stack")
              : ""
          }
        </span>
      </p>

      <div class="relative z-40 opacity-0 entry-element">
        <RotateText
          client:load
          className="text-blue-800 dark:text-blue-300"
          texts={t("sections_data.about.stack_variations")}
        />
      </div>
    </div>

    <p class="w-auto text-gray-500 dark:text-gray-400 opacity-0 entry-element">
      {t("sections_data.about.tagline")}
    </p>
  </div>

  <div class="w-full flex items-center justify-center-safe p-2 md:p-0">
    <img
      id="hero-img"
      class="rounded-full opacity-0"
      src="/me.webp"
      alt={t("sections_data.about.pfp_alt")}
      width="300"
      height="300"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const handleDOMContentLoaded = () => {
    const AVATAR_DURATION = 2.0;
    const TEXT_ENTRY_DURATION = 0.8;
    const STAGGER_DELAY = 0.15;
    const TEXT_OVERLAP_TIME = 0.6;
    const BASE_EASE = "power3.out";

    const timeline = gsap.timeline({
      defaults: { ease: BASE_EASE },
      onComplete: () => {
        const typewriter = document.getElementById("typewriter-text");
        if (typewriter) {
          typewriter.classList.add("typewriter");
        }

        window.dispatchEvent(new CustomEvent("hero-animation-done"));
      },
    });

    timeline.fromTo(
      "#hero-img",
      { opacity: 0, scale: 0.8 },
      { opacity: 1, scale: 1, duration: AVATAR_DURATION },
    );

    const textStartTime = AVATAR_DURATION - TEXT_OVERLAP_TIME;

    timeline.fromTo(
      ".entry-element",
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: TEXT_ENTRY_DURATION,
        stagger: STAGGER_DELAY,
      },
      textStartTime,
    );
  };

  document.addEventListener("DOMContentLoaded", handleDOMContentLoaded);
</script>
