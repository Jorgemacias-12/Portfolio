---
import { RotateText } from "@/components/react/RotateText";
import { type Locale } from "@/types";
import { getTranslation } from "@/utils";

const { currentLocale } = Astro;
const { t } = getTranslation(currentLocale as Locale);
---

<section class="flex flex-col-reverse md:flex-row gap-4">
  <div class="w-auto flex flex-col gap-4 space-y-4">
    <div class="flex flex-col gap-4">
      <p class="text-lg text-gray-500 dark:text-gray-400">
        {t("sections_data.about.greeting")}
      </p>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground text-balance"
      >
        {t("sections_data.about.short_name")}
      </h1>

      <p
        class="text-xl sm:text-2xl text-accent-600 dark:text-accent-500 font-medium"
      >
        {t("sections_data.about.position")}
      </p>

      <p class="inline-flex flex-col gap-2 w-fit">
        <span
          class="typewriter text-accent-600 dark:text-accent-500 text-xl"
          style={{
            "--characters":
              typeof t("sections_data.about.stack") === "string"
                ? t("sections_data.about.stack").length
                : 0,
          } as React.CSSProperties}
          >{
            typeof t("sections_data.about.stack") === "string"
              ? t("sections_data.about.stack")
              : ""
          }
        </span>
      </p>

      <div class="relative z-40">
        <RotateText
          client:load
          className="text-blue-800 dark:text-blue-300"
          texts={t("sections_data.about.stack_variations")}
        />
      </div>
    </div>

    <p class="w-auto text-gray-500 dark:text-gray-400">
      {t("sections_data.about.tagline")}
    </p>
  </div>

  <div class="w-full flex items-center justify-center-safe p-2 md:p-0">
    <img
      class="rounded-full"
      src="/me.webp"
      alt={t("sections_data.about.pfp_alt")}
      width="300"
      height="300"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
