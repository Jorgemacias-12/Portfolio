---
import EducationCard from "@/components/astro/EducationCard.astro";
import type { Education, Locale } from "@/types";
import { getTranslation } from "@/utils";

const { t } = getTranslation(Astro.currentLocale as Locale);
const education = Object.values(t("sections_data.education")) as Education[];
---

<section class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {education.map((e) => <EducationCard {...e} />)}
</section>
