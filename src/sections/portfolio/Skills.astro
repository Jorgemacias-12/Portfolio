---
import Badge from "@/components/astro/Badge.astro";
import Card from "@/components/astro/Card.astro";
import type { Locale } from "@/types";
import { getTranslation } from "@/utils";
import { twMerge } from "tailwind-merge";

const { t } = getTranslation(Astro.currentLocale as Locale);
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
  {
    Object.values(t("sections_data.skills")).map(
      ({ label, color, tagline, technologies }) => {
        return (
          <Card class="flex flex-col justify-between gap-4">
            <h3 class={color}>{label}</h3>

            <section class="flex flex-wrap gap-2">
              {technologies.map((el) => (
                <Badge {...el} />
              ))}
            </section>

            <footer class="text-sm">{tagline}</footer>
          </Card>
        );
      },
    )
  }
</div>
